# ============================================
# BITLANCE GROUND OS — Environment Variables
# ============================================
# Copy to .env and fill in values

# ── Database ─────────────────────────────────
DATABASE_URL="postgresql://groundos:groundos@localhost:5432/groundos_dev"

# ── Redis ────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── API Server ───────────────────────────────
API_PORT=4000
API_HOST=localhost
NODE_ENV=development

# ── JWT Auth ─────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Object Storage (S3-compatible) ───────────
STORAGE_PROVIDER=mock
STORAGE_BUCKET=ground-os-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=

# ── AI / LLM Provider ────────────────────────
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Speech-to-Text ───────────────────────────
STT_PROVIDER=mock
DEEPGRAM_API_KEY=
GOOGLE_SPEECH_API_KEY=

# ── WhatsApp ─────────────────────────────────
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# ── Voice AI ─────────────────────────────────
VOICE_PROVIDER=mock
BLAND_AI_API_KEY=
RETELL_API_KEY=

# ── Maps / GPS ───────────────────────────────
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

# ── Creative Engine ──────────────────────────
CREATIVE_PROVIDER=mock
CREATIVE_API_KEY=

# ── Realtime Gateway ─────────────────────────
REALTIME_PORT=4001

# ── Frontend ─────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4001
VITE_MAPS_API_KEY=

# ── Demo / Seed ──────────────────────────────
DEMO_ORG_NAME="Lifestyle Homes"
DEMO_ADMIN_EMAIL=admin@lifestylehomes.in
DEMO_ADMIN_PASSWORD=demo1234

# ── Supabase ─────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
