{
  "name": "@ground-os/worker",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@prisma/client --external:dotenv --external:winston --external:@google/genai",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ground-os/database": "*",
    "@ground-os/types": "*",
    "dotenv": "^16.4.5",
    "winston": "^3.13.0",
    "@google/genai": "^2.23.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.0"
  }
}
